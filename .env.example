# Copy this file to .env and fill in your values. NEVER commit .env.
GROQ_API_KEY=
# Copy the current vision model id from console.groq.com/docs/vision
GROQ_VISION_MODEL=
# Seconds to wait between AI calls (protects the free tokens-per-minute limit)
SLEEP_SECONDS=30
AI_PROVIDER_CHAIN=groq,cache,mock
DATABASE_URL=sqlite:///./aqualens.db
# Demo-only expert access code
EXPERT_PIN=change-me
FHIR_SERVER_URL=https://hapi.fhir.org/baseR4
FHIR_CODESYSTEM_URL=https://example.org/aqualens/CodeSystem/stream-observation
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# For phone testing on LAN without the Vite proxy, also add http://YOUR_LAN_IP:5173
# Photo storage: local (default) or supabase
STORAGE_BACKEND=local
UPLOAD_DIR=../uploads
AI_CACHE_DIR=../cache/ai
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=aqualens-photos
